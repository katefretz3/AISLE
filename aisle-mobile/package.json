{
  "name": "aisle-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "sync": "npm run build && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "check": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "photos": "node tools/fetch-product-photos.mjs",
    "ia": "node tools/ia-study.mjs --write",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run lint && npm run format:check && npm test && npm run build",
    "test:e2e": "playwright test",
    "release:check": "node tools/release-check.mjs",
    "release": "npm run verify && npm run release:check && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
