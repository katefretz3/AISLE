# Optional. Enables the agent's assisted matching and explanations.
# This is the URL of a broker you run (see ../server/agent-broker.ts).
# The Anthropic API key lives on that broker and is never bundled into the app.
# With this unset, the agent runs its rule-based planner instead; prices and
# totals are identical either way.
VITE_AISLE_AGENT_ENDPOINT=
VITE_AISLE_AGENT_MODEL=claude-opus-5-5
VITE_AISLE_AGENT_MAX_TOKENS=16000

# Optional. An https:// page where retailers and the OpenStreetMap directory can
# reach whoever operates this build. Appended to the User-Agent the native app
# sends. Left out entirely when unset; Aisle does not make one up.
VITE_AISLE_CONTACT_URL=
